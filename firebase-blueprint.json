{
  "entities": {
    "LiveSession": {
      "collection": "live_sessions",
      "fields": {
        "sessionId": { "type": "string" },
        "sessionPin": { "type": "string" },
        "isProgramActive": { "type": "boolean" },
        "lessonTitle": { "type": "string" },
        "videoUrl": { "type": "string" },
        "status": { "type": "string" },
        "currentQuestionIndex": { "type": "number", "nullable": true },
        "currentQuestion": { "type": "object", "nullable": true },
        "questionTriggeredAt": { "type": "number", "nullable": true },
        "timeLimit": { "type": "number" },
        "showResult": { "type": "string" },
        "connectedStudents": { "type": "array" },
        "answersForCurrentQuestion": { "type": "object" },
        "allSessionAnswers": { "type": "object" },
        "subtitleState": { "type": "object", "nullable": true },
        "updatedAt": { "type": "number" }
      }
    },
    "LiveSubtitlesCatalog": {
      "collection": "live_sessions",
      "fields": {
        "lines": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    },
    "AdminAccessRegistry": {
      "collection": "live_sessions",
      "fields": {
        "requireHomeLogin": { "type": "boolean" },
        "requireAdminLogin": { "type": "boolean" },
        "users": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    },
    "LiveVotingConfig": {
      "collection": "live_sessions",
      "fields": {
        "activePoll": { "type": "object" },
        "presetQuestions": { "type": "array" },
        "presetOptionSets": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    },
    "VoteParticipant": {
      "collection": "live_sessions/voting/participants",
      "fields": {
        "roundId": { "type": "string" },
        "voterId": { "type": "string" },
        "voterType": { "type": "string" },
        "name": { "type": "string", "nullable": true },
        "sheetNumber": { "type": "string", "nullable": true },
        "joinedAt": { "type": "number" },
        "lastSeen": { "type": "number" }
      }
    },
    "VoteSubmission": {
      "collection": "live_sessions/voting/votes",
      "fields": {
        "roundId": { "type": "string" },
        "voterId": { "type": "string" },
        "voterType": { "type": "string" },
        "name": { "type": "string", "nullable": true },
        "sheetNumber": { "type": "string", "nullable": true },
        "optionId": { "type": "string" },
        "optionLabel": { "type": "string" },
        "votedAt": { "type": "number" }
      }
    }
  }
}
